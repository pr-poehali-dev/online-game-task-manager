{
  "tests": [
    {
      "name": "OPTIONS CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET without token returns 401",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST with bad signature returns 403",
      "method": "POST",
      "path": "/",
      "body": {"telegram": {"id": 123, "first_name": "Test", "auth_date": 1700000000, "hash": "deadbeef"}},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST set_theme without token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"action": "set_theme", "theme": "light"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST set_nickname without token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"action": "set_nickname", "nickname": "Test"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST upload_avatar without token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"action": "upload_avatar", "data": "aGVsbG8="},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST remove_avatar without token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"action": "remove_avatar"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
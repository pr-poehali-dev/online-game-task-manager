# Таймер — запускает era-logs-indexer.service каждую минуту (свежие события появляются в
# кабинете почти сразу после того, как игровой сервер дописал их в файл лога).
# Если минутный интервал избыточен для вашей нагрузки — увеличьте OnUnitActiveSec (например
# "5min").
#
# Установка — см. комментарий в era-logs-indexer.service.

[Unit]
Description=Таймер: индексация логов раз в минуту

[Timer]
OnBootSec=30s
OnUnitActiveSec=1min
AccuracySec=5s
Persistent=true

[Install]
WantedBy=timers.target

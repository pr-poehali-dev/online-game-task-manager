# Настройки индексатора логов. Скопируйте в .env рядом с indexer.py и заполните.
# Этот .env НЕ путать с /var/www/era/deploy/.env (основного backend проекта) — это ОТДЕЛЬНЫЙ
# набор переменных для скрипта, который живёт на хостинге логов (может быть тот же сервер, что
# и основной backend, а может быть и совсем другой — где физически лежат файлы логов).

# --- Обязательные ---

# Подключение к БАЗЕ ЛОГОВ (та, что создана schema.sql) — НЕ основная база проекта ERA.
# Если создаёте на этом же Postgres-сервере отдельной базой:
#   sudo -u postgres psql -c "CREATE DATABASE era_logs OWNER era_user;"
LOGS_DB_URL=postgresql://era_user:ВАШ_ПАРОЛЬ@localhost:5432/era_logs

# Корневая папка на диске, где лежат подпапки СЕРВЕРОВ с логами. Внутри LOGS_ROOT/<server_id>/
# ожидаются три подпапки: cashed/ (да, через "а" — так называется папка на реальном сервере),
# server/, npc/. Например если игровой сервер называется "c4x1" и его логи лежат в
# /var/www/l2logs/c4x1/cashed/*.log — укажите LOGS_ROOT=/var/www/l2logs
LOGS_ROOT=/var/www/l2logs

# Список id серверов через запятую — ДОЛЖНЫ совпадать с servers.id в ОСНОВНОЙ базе проекта
# (раздел кабинета «Серверы»). Пример: LOGS_SERVERS=c4x1,hf_old,hf_new
LOGS_SERVERS=c4x1

# --- Необязательные ---

# Сколько дней истории хранить в logs_events — старые события удаляются автоматически при
# каждом запуске индексатора. По умолчанию 7.
RETENTION_DAYS=7

# --- Резолв имён предметов/нпс/скиллов (необязательно, но рекомендуется) ---
# Если заполнить эти три переменные — индексатор будет резолвить item_id/npc_id/skill_id в
# человекочитаемые имена ИЗ ДЕРЕВА ПАТЧЕЙ (тот же принцип, что раздел «Патчи» кабинета), и в
# кабинете логи будут показывать "Draconic Bow", а не просто "7575". Если НЕ заполнить — логи
# всё равно будут работать, просто с числовыми id вместо имён.

# Подключение к ОСНОВНОЙ базе проекта ERA (та же, что в /var/www/era/deploy/.env DATABASE_URL) —
# нужно, чтобы найти, в каком S3-файле лежит дерево патчей нужного сервера.
MAIN_DB_URL=postgresql://era_user:ВАШ_ПАРОЛЬ@localhost:5432/era_db
MAIN_DB_SCHEMA=public

# S3-доступ (тот же MinIO/Object Storage, что использует основной backend — см.
# /var/www/era/deploy/.env: AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/S3_ENDPOINT/S3_BUCKET)
AWS_ACCESS_KEY_ID=ВАШ_КЛЮЧ
AWS_SECRET_ACCESS_KEY=ВАШ_СЕКРЕТ
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=files

{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET without token unauthorized",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {"error": "unauthorized"},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET og_meta without token but bad id",
      "method": "GET",
      "path": "/?action=og_meta&id=abc",
      "expectedStatus": 400,
      "expectedBody": {"error": "bad_request"},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET og_meta without token, missing task",
      "method": "GET",
      "path": "/?action=og_meta&id=999999999",
      "expectedStatus": 404,
      "expectedBody": {"error": "not_found"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST create without token unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"action": "create", "title": "Test"},
      "expectedStatus": 401,
      "expectedBody": {"error": "unauthorized"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST private_note_add without token unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"action": "private_note_add", "taskId": 1, "targetUserId": 2, "text": "test"},
      "expectedStatus": 401,
      "expectedBody": {"error": "unauthorized"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST comment without token unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"action": "comment", "taskId": 1, "withPrivateNote": true},
      "expectedStatus": 401,
      "expectedBody": {"error": "unauthorized"},
      "bodyMatcher": "partial"
    }
  ]
}